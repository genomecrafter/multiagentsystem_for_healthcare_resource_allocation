    {
      "title": "Demand Forecasting Tool",
      "description": "The Demand Forecasting Tool enhances the capability of the Demand Assessment Agent (DAA) by providing accurate predictions of future healthcare resource demand. It analyzes historical data, current trends, and external factors to forecast potential shortages or surges in healthcare resources like hospital beds, ventilators, and staff. The tool empowers decision-makers to take proactive measures to address predicted challenges, ensuring efficient resource management.",
      "chain_id": "9404635a-e1dd-4de7-a4a8-350cd32fb75b",
      "project": "9df72144a0d9-4145-b7a5-00a5baf4e753",
