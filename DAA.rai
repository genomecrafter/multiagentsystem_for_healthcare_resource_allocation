  "agent_id": "e00f1d83-184a-45ea-ae9e-1d491796bba9",
  "emoji": "https://cdn.jsdelivr.net/gh/RelevanceAI/content-cdn@latest/agents/agent_avatars/agent_avatar_18.svg",
