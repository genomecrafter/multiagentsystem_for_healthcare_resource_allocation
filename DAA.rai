    {
      "emoji": "https://cdn.jsdelivr.net/gh/RelevanceAI/content-cdn@latest/agents/agent_avatars/agent_avatar_02.svg",
      "title": "Proactive Resource Mobilization Agent",
      "description": "The Proactive Resource Mobilization Agent (PRMA) is designed to ensure long-term preparedness and resilience in healthcare resource management. This agent identifies future resource needs based on demand forecasts, maintains emergency reserves, and coordinates with suppliers to address shortages before they occur. By analyzing trends and integrating real-time data, the PRMA ensures that healthcare systems are well-equipped to handle both routine demands and sudden surges caused by emergencies or seasonal factors.\n\n",
      "agent_id": "830f8912-676d-4f76-af4a-4b84aab0cdeb",
      "action_behaviour": "never-ask",
      "default_values": {},
