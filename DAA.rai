      "action_behaviour": "agent-decide"
    },
    {
      "emoji": "https://cdn.jsdelivr.net/gh/RelevanceAI/content-cdn@latest/agents/agent_avatars/agent_avatar_09.svg",
      "title": "Resource Allocation Agent",
      "description": "It is designed to optimize the distribution of healthcare resources across facilities and regions. It ensures equitable and efficient allocation of critical resources, such as hospital beds, ventilators, and medical staff, by analyzing demand forecasts, resource availability, and geographic constraints. By employing advanced optimization algorithms and contingency planning, the RAA enables healthcare systems to respond dynamically to both routine and emergency scenarios.",
      "agent_id": "5edc603c-7965-4fe3-9ba9-0b61c5b47344",
      "action_behaviour": "never-ask",
      "default_values": {},
